<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cz.cuni.mff.ui.controller.DownloadController">
    <padding>
        <Insets top="12.0" right="0.0" bottom="0.0" left="0.0"/>
    </padding>
    <Label text="Download with direct link" styleClass="section-title"/>
    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <TextField fx:id="urlField" promptText="https://huggingface.co/../...gguf" styleClass="search-field" HBox.hgrow="ALWAYS"/>
        <Button fx:id="downloadButton" text="Download" onAction="#onDownload"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" disable="true"/>
    </HBox>
    <ProgressBar fx:id="progressBar" maxWidth="Infinity" visible="false"/>
    <Label fx:id="downloadStatus" styleClass="model-text"/>
</VBox>